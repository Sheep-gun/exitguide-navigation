{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exitguide.local/contracts/navigation-goal-crosswalk.v1.schema.json",
  "title": "ExitGuide Navigation Goal Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "crosswalk_version", "status", "source_namespace",
    "target_namespace", "mappings", "rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "crosswalk_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "provisional_validated", "active", "retired"]},
    "source_namespace": {"const": "yanggeon.navigation.goal"},
    "target_namespace": {"const": "exitguide.goal"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_goal_id", "target_goal_id", "mapping_type", "conditions",
          "related_target_goal_ids"
        ],
        "properties": {
          "source_goal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "target_goal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "mapping_type": {"enum": ["exact", "narrow", "broad", "conditional"]},
          "conditions": {"type": "array", "items": {"type": "object"}},
          "related_target_goal_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "uniqueItems": true
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids_are_not_runtime_ids", "unmapped_goal_policy",
        "conditional_mapping_requires_explicit_context",
        "membership_and_subscription_are_not_synonyms"
      ],
      "properties": {
        "source_ids_are_not_runtime_ids": {"const": true},
        "unmapped_goal_policy": {"const": "reject_and_record"},
        "conditional_mapping_requires_explicit_context": {"const": true},
        "membership_and_subscription_are_not_synonyms": {"const": true}
      }
    }
  }
}
