{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exitguide.local/contracts/goals.v1.schema.json",
  "title": "ExitGuide Shared Goal Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label_ko"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label_ko": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
