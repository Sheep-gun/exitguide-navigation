NAVIGATION_DECISION_DB_PATH=/absolute/path/navigation-decision-v1.sqlite
NAVIGATION_RUNTIME_DB_PATH=.artifacts/navigation-runtime-v1.sqlite
NAVIGATION_DATASET_SPLIT_MANIFEST_PATH=db/navigation_dataset_split_v1.json
NAVIGATION_ALLOW_LOCKED_HOLDOUT=false

# Solar Pro 3 LLM planner (Upstage OpenAI-compatible endpoint)
NAVIGATION_PLANNER_PROVIDER=solar_pro3
NAVIGATION_PLANNER_API_KEY=
NAVIGATION_PLANNER_BASE_URL=https://api.upstage.ai/v1
NAVIGATION_PLANNER_MODEL=solar-pro3

# EXAONE 4.5 VLM (OpenAI-compatible endpoint)
EXAONE_VLM_API_KEY=
EXAONE_VLM_BASE_URL=
EXAONE_VLM_MODEL=EXAONE-4.5-33B
EXAONE_VLM_TEAM=

# Safe offline fallback is useful before the two model endpoints are connected.
NAVIGATION_MODEL_ALLOW_FALLBACK=true
NAVIGATION_PLANNER_TIMEOUT_SECONDS=20

# always: research/A-B, selective: runtime default, disabled: endpoint isolation
NAVIGATION_PLANNER_MODE=selective
NAVIGATION_PLANNER_SCORE_THRESHOLD=0.90
NAVIGATION_PLANNER_MARGIN_THRESHOLD=0.25
NAVIGATION_VLM_MODE=selective
